<layout>

    <translate x="900" y="800" name="speed_gauge">
        <component type="metric" x="45" y="45" metric="speed" units="kph" size="60" dp="0" rgb="255,255,255,255" outline="0,0,0,160"/>
        <component type="cairo-gauge-marker" metric="speed" units="kph" size="160" start="90" length="360" sectors="1" max="50"/>
    </translate>


    <composite x="16" y="980" name="altitude">
        <component type="metric_unit" x="70" y="0" metric="alt" units="alt" size="16">ALT({:~C})</component>
        <component type="icon" x="0" y="0" file="mountain.png" size="64"/>
        <component type="metric" x="70" y="18" metric="alt" units="alt" dp="1" size="32" />
    </composite>

    <composite x="220" y="980" name="gradient">
        <component type="text" x="70" y="0" size="16">SLOPE(%)</component>
        <component type="icon" x="0" y="0" file="slope-triangle.png" size="64"/>
        <component type="metric" x="70" y="18" metric="gradient" dp="1" size="32" />
    </composite>

    <composite x="424" y="980" name="cadence">
        <component type="text" x="70" y="0" size="16">RPM</component>
        <component type="icon" x="0" y="0" file="gauge.png" size="64"/>
        <component type="metric" x="70" y="18" metric="cadence" dp="0" size="32" />
    </composite>

    <composite x="628" y="980" name="hr">
        <component type="text" x="70" y="0" size="16">BPM</component>
        <component type="icon" x="0" y="0" file="heartbeat.png" size="64"/>
        <component type="metric" x="70" y="18" metric="hr" dp="0" size="32" />
    </composite>

    <composite x="832" y="970" name="power">
        <component type="zone-bar" width="400" height="75" metric="power" max="400" z1="130" z2="160" z3="200" z0-rgb="67, 235, 52,200" z1-rgb="67,235,52,200" z2-rgb="240,232,19,200" z3-rgb="207,19,2,200" />
        <component type="icon" x="140" y="10" file="power.png" size="64"/>
        <!-- <component type="text" x="200" y="10" size="16">W</component> -->
        <component type="metric" x="200" y="10" metric="power" dp="0" size="48" />
    </composite>

    <component type="chart" name="power_chart" metric="power" units="watts" x="1250" y="980"/>

    <composite x="1900" y="980" name="temperature">
        <component type="metric_unit" x="-70" y="0" size="16" align="right" metric="temp" units="temp">TEMP({:~C})</component>
        <component type="icon" x="-64" y="0" file="thermometer.png" size="64"/>
        <component type="metric" x="-70" y="18" dp="0" size="32" align="right" metric="temp" units="temp"/>
    </composite>


    <translate x="1550" y="700">
        <component type="cairo_circuit_map" size="300"/>
    </translate>


    <component type="moving_map" name="moving_map" rotate="False" x="1644" y="10" size="256" zoom="16" corner_radius="35"/>
</layout>
